# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=               # Secret used to sign session JWTs

# ── Push Notifications (optional) ────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=            # e.g. mailto:you@example.com
